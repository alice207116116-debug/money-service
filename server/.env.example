# 서버 포트
PORT=4000

# Supabase 프로젝트 설정 → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secrets → Legacy JWT (or current JWT secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Database → Connection string → URI (서버는 이걸로 직접 쿼리해요)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# 로컬/프록시 환경에서 SSL 검증을 끄고 싶지 않으면 false
PG_SSL=true
